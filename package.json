{
  "name": "bg-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Tracker Hearthstone dedie au mode Champs de bataille",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "parse": "tsx src/cli/parse.ts",
    "import": "tsx src/cli/import.ts",
    "cards": "tsx src/cli/cards.ts",
    "ratings": "tsx src/cli/ratings.ts",
    "stats": "tsx src/cli/stats.ts",
    "archive": "tsx scripts/archive-logs.ts",
    "make-fixture": "tsx scripts/make-fixture.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  }
}
